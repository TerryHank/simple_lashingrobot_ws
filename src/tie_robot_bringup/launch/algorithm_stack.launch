<launch>
    <node name="pointAINode"
          pkg="tie_robot_perception"
          type="pointai_node.py"
          output="log"
          respawn="true"
          respawn_delay="2.0">
        <env name="ROSCONSOLE_FORMAT" value="[${severity}] ${message}" />
        <param name="scan_linear_compensation_enabled" value="false" />
        <param name="scan_linear_compensation_reference_z_mm" value="1000.0" />
        <param name="scan_linear_compensation_x_per_mm" value="0.0" />
        <param name="scan_linear_compensation_y_per_mm" value="0.0" />
        <param name="scan_linear_compensation_min_z_mm" value="1200.0" />
        <param name="scan_linear_compensation_max_abs_scale_delta" value="0.25" />
        <param name="bind_classification_config_path" value="$(find tie_robot_perception)/config/bind_point_classification.yaml" />
    </node>

    <node name="bind_map_builder"
          pkg="tie_robot_process"
          type="architecture_role_node.py"
          output="log"
          respawn="true"
          respawn_delay="2.0">
        <param name="role_name" value="bind_map_builder" />
    </node>

    <node name="global_bind_planner"
          pkg="tie_robot_process"
          type="global_bind_planner_node.py"
          output="log"
          respawn="true"
          respawn_delay="2.0">
    </node>

    <node name="cabin_motion_controller"
          pkg="tie_robot_process"
          type="cabin_motion_controller_node"
          output="log"
          respawn="true"
          respawn_delay="2.0">
    </node>

    <node name="moduan_motion_controller"
          pkg="tie_robot_control"
          type="moduan_motion_controller_node"
          output="log"
          respawn="true"
          respawn_delay="2.0">
    </node>

    <node name="bind_task_executor"
          pkg="tie_robot_process"
          type="bind_task_executor_node"
          output="log"
          respawn="true"
          respawn_delay="2.0">
    </node>
</launch>
