<launch>
    <arg name="with_camera" default="true" />
    <arg name="with_tf" default="true" />
    <arg name="camera_respawn" default="false" />
    <arg name="process_image_service_name" default="/pointAI/process_image" />
    <arg name="cabin_state_topic" default="/cabin/cabin_data_upload" />
    <arg name="moduan_state_topic" default="/moduan/moduan_gesture_data" />

    <group if="$(arg with_camera)">
        <include file="$(find tie_robot_vision)/launch/scepter_camera.launch">
            <arg name="camera_respawn" value="$(arg camera_respawn)" />
        </include>
    </group>

    <group if="$(arg with_tf)">
        <node name="robot_tf_broadcaster"
              pkg="tie_robot_vision"
              type="robot_tf_broadcaster.py"
              output="screen">
            <param name="map_frame" value="map" />
            <param name="base_link_frame" value="base_link" />
            <param name="scepter_frame" value="Scepter_depth_frame" />
            <param name="cabin_state_topic" value="$(arg cabin_state_topic)" />
            <param name="depth_topic" value="/Scepter/depth/image_raw" />
            <param name="config_path" value="$(find tie_robot_vision)/config/robot_home_tf.yaml" />
            <param name="publish_rate_hz" value="30.0" />
        </node>

        <node name="gripper_tf_broadcaster"
              pkg="tie_robot_vision"
              type="gripper_tf_broadcaster.py"
              output="screen">
            <param name="config_path" value="$(find tie_robot_vision)/config/gripper_tf.yaml" />
            <param name="publish_rate_hz" value="30.0" />
        </node>
    </group>

    <node name="pointAINode"
          pkg="tie_robot_vision"
          type="pointai_node.py"
          output="screen">
        <env name="ROSCONSOLE_FORMAT" value="[${severity}] ${message}" />
        <param name="process_image_service_name" value="$(arg process_image_service_name)" />
        <param name="moduan_state_topic" value="$(arg moduan_state_topic)" />
        <param name="scan_linear_compensation_enabled" value="false" />
        <param name="scan_response_source" value="depth_gradient" />
    </node>
</launch>
